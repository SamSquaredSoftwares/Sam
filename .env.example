# Copy this file to .env and fill in your values.
# .env is gitignored and loaded automatically by scripts/run_local.sh.

# --- Snowflake (required for the Snowflake actions) ---
# Account identifier, e.g. myorg-myaccount (from your Snowflake account URL:
# https://<account_identifier>.snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Password auth (option A)
SNOWFLAKE_PASSWORD=

# Key-pair auth (option B) - takes precedence over the password when set.
# Path to a PKCS#8 private key; passphrase only if the key is encrypted.
#SNOWFLAKE_PRIVATE_KEY_PATH=
#SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Optional session defaults
#SNOWFLAKE_WAREHOUSE=COMPUTE_WH
#SNOWFLAKE_DATABASE=
#SNOWFLAKE_SCHEMA=
# Prefer a read-only role here -- see snowflake/README.md
#SNOWFLAKE_ROLE=SAM_READONLY

# --- Anthropic (required for the ask_claude action) ---
ANTHROPIC_API_KEY=
